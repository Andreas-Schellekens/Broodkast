# Kopieer naar .env en vul in. Op Railway zet je deze als service-variabelen.

# Bot-token uit het Discord Developer Portal (Bot → Reset Token)
DISCORD_TOKEN=

# Optioneel: ID van je testserver. Gezet = commando's worden alleen daar en meteen geregistreerd.
# Leeg = globale registratie (kan tot een uur duren). Laat leeg in productie.
DEV_GUILD_ID=

# Optioneel: sleutel van api.nasa.gov voor /apod. Zonder sleutel wordt DEMO_KEY gebruikt.
NASA_API_KEY=

# Database. Lokaal een bestand in de projectmap; de Docker-image gebruikt /data/broodkast.db.
# DATABASE_URL=sqlite://broodkast.db

# Webserver voor /health en inkomende webhooks. Railway zet PORT zelf.
# PORT=8080
# Publieke URL van de webserver, nodig voor /volg webhook. Op Railway automatisch
# afgeleid uit RAILWAY_PUBLIC_DOMAIN als je een domein genereert.
# PUBLIC_URL=http://localhost:8080

# Optioneel: Twitch-integratie. Maak een app op https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optioneel: logniveau, bv. "debug" of "info,broodkast=debug"
# RUST_LOG=info
