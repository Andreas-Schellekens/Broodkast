# Kopieer naar .env en vul in.

# Bot-token uit het Discord Developer Portal (Bot → Reset Token)
DISCORD_TOKEN=

# Optioneel: ID van je testserver. Gezet = commando's worden alleen daar en meteen geregistreerd.
# Leeg = globale registratie (kan tot een uur duren).
DEV_GUILD_ID=

# Optioneel: sleutel van api.nasa.gov voor /apod. Zonder sleutel wordt DEMO_KEY gebruikt.
NASA_API_KEY=

# Optioneel: logniveau, bv. "debug" of "info,broodkast=debug"
# RUST_LOG=info
